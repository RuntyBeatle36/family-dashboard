#!/bin/sh
# /usr/local/sbin/family-dashboard-firstboot — runs once, as root, on the
# first boot of a card made from a plug-and-play image (installed and
# enabled by scripts/prepare-image.sh), then disables itself.
#
# Makes each copy its own device:
#   - fresh SSH host keys (prepare-image.sh deleted the master's)
#   - a random login password for `user`, so no two units share one. It's
#     saved to /etc/family-dashboard/device-password (readable by root and
#     the app account only), which the dashboard shows on its own screen in
#     Debug Tools ▸ Device Login.
set -eu

ssh-keygen -A

PWFILE=/etc/family-dashboard/device-password
APP_GROUP="$(id -gn fdash 2>/dev/null || echo root)"
if [ ! -s "$PWFILE" ]; then
  install -d -o root -g "$APP_GROUP" -m 750 /etc/family-dashboard
  # No look-alike characters (0/O, 1/l/I), so it can be read off the screen
  PW="$(tr -dc 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789' </dev/urandom | head -c 16)"
  echo "user:$PW" | chpasswd
  umask 077
  printf '%s\n' "$PW" > "$PWFILE"
  chown root:"$APP_GROUP" "$PWFILE"
  chmod 640 "$PWFILE"
fi

systemctl disable family-dashboard-firstboot.service
