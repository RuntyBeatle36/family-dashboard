# /etc/systemd/system/dashboard.service
# A template: scripts/setup-app-account.sh fills in @APP_USER@ / @APP_DIR@
# and installs it. The app runs as its own account, not the desktop login.
[Unit]
Description=Family Dashboard
After=network.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
# Piper is a standalone binary + voice model, not an apt package (see
# system/packages.txt) — installed into piper/ inside the app folder rather
# than relying on it being on PATH, since a systemd service gets a minimal
# default PATH that doesn't include wherever a manually-installed binary
# might live.
Environment=PIPER_BIN=@APP_DIR@/piper/piper
ExecStart=/usr/bin/node server.js
Restart=always

[Install]
WantedBy=multi-user.target
